# Copy to .dev.vars for local development. Configure production values via
# Cloudflare Worker secrets/variables. Never commit real secrets.
# Generate a unique secret with at least 32 characters. No default is accepted.
ADMIN_TOKEN=
# Optional independent secret for durable private guest-status links (32+ chars).
BOOKING_SECRET=
SITE_ORIGIN=https://your-production-domain.example
# Test keys only. Live Stripe keys are deliberately rejected in this version.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Payments stay disabled. A future developer may opt into sandbox tests only.
PAYMENTS_ENABLED=disabled
# Optional bearer secret for the external HTTP refresh endpoint (32+ chars).
# The built-in Worker cron does not use the HTTP endpoint or need this secret.
SYNC_SECRET=
